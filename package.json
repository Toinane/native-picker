  "bugs": {
    "url": "https://github.com/Toinane/native-picker/issues"
  },
  "homepage": "https://github.com/Toinane/native-picker#readme",
  "dependencies": {
    "node-addon-api": "^8.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "node-gyp": "^10.2.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "binary": {
